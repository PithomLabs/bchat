# Dockerfile.ecs - CockroachDB Vector Store Build
# Multi-stage build for ECS deployment with CockroachDB support

# Build stage
FROM golang:1.26-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git

WORKDIR /app

# Copy go.mod and go.sum first for better caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build with cockroach tag for CockroachDB vector support (no CGO needed for pgx)
ENV CGO_ENABLED=0
RUN go build -tags "cockroach" -ldflags="-s -w" -o /app/memos ./bin/memos

# Runtime stage
FROM alpine:3.18

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/memos /app/memos

# Create data directory
RUN mkdir -p /app/data

# Expose port
EXPOSE 8081

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost:8081/api/v1/status || exit 1

# Run with cockroach vector store
ENTRYPOINT ["/app/memos"]
CMD ["--mode", "prod", "--data", "/app/data"]
